# ==============================================================================
# SiDag — Sistem Informasi Asesmen Diagnostik Tiga Tingkat (Matematika)
# Environment Variables Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Server Network Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Data Storage & Persistence Paths
# In Docker, /app/data is mounted to a persistent Docker named volume or host path
DATA_DIR=/app/data
DATA_FILE=/app/data/database.json
SQLITE_DB_PATH=/app/data/sidag.db
DATABASE_URL=file:data/sidag.db

# Timezone Configuration (SMAN 7 Banjarmasin is in WITA / UTC+8)
TZ=Asia/Makassar

# Security & CORS (Optional)
CORS_ORIGIN=*
